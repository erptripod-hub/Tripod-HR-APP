{
  "doctype": "DocType",
  "name": "CTC Component Default",
  "module": "Tripod HR",
  "engine": "InnoDB",
  "naming_rule": "By fieldname",
  "autoname": "field:branch",
  "title_field": "branch",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "branch",
      "label": "Branch",
      "fieldtype": "Link",
      "options": "Branch",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "company",
      "label": "Company",
      "fieldtype": "Link",
      "options": "Company",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "country",
      "label": "Country (for Gratuity rule)",
      "fieldtype": "Select",
      "options": "UAE\nKSA",
      "reqd": 1,
      "in_list_view": 1,
      "default": "UAE"
    },
    {
      "fieldname": "is_ksa_national_branch",
      "label": "KSA National Branch",
      "fieldtype": "Check",
      "default": 0,
      "description": "Salary only, no allowances calculated"
    },
    {
      "fieldname": "section_break_components",
      "label": "Default Component Amounts (Monthly)",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "default_accommodation",
      "label": "Accommodation",
      "fieldtype": "Currency",
      "default": 0
    },
    {
      "fieldname": "default_visa",
      "label": "Visa (UAE)",
      "fieldtype": "Currency",
      "default": 0,
      "depends_on": "eval:doc.country == 'UAE'"
    },
    {
      "fieldname": "default_iqama",
      "label": "Iqama (KSA)",
      "fieldtype": "Currency",
      "default": 0,
      "depends_on": "eval:doc.country == 'KSA'"
    },
    {
      "fieldname": "default_medical_insurance",
      "label": "Medical Insurance",
      "fieldtype": "Currency",
      "default": 0
    },
    {
      "fieldname": "column_break_components",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "default_ticket_allowance",
      "label": "Ticket Allowance",
      "fieldtype": "Currency",
      "default": 0
    },
    {
      "fieldname": "default_transport",
      "label": "Transport",
      "fieldtype": "Currency",
      "default": 0
    },
    {
      "fieldname": "section_break_gratuity",
      "label": "Gratuity Rules",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "gratuity_days_year1to5",
      "label": "Gratuity Days/Year (1-5 yrs)",
      "fieldtype": "Int",
      "default": 21,
      "description": "UAE: 21, KSA: 15"
    },
    {
      "fieldname": "gratuity_days_year5plus",
      "label": "Gratuity Days/Year (5+ yrs)",
      "fieldtype": "Int",
      "default": 30
    },
    {
      "fieldname": "probation_years_no_gratuity",
      "label": "Probation Years (no gratuity)",
      "fieldtype": "Int",
      "default": 1,
      "description": "UAE: 1, KSA: 2"
    }
  ],
  "permissions": [
    {
      "role": "HR Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 0
    },
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ]
}
